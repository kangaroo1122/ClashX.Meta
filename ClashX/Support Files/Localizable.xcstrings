  },
  "Install later": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Install later"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "稍后安装"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "稍後安裝"
        }
      }
    }
  },
  "Install now": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Install now"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "立即安装"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "立即安裝"
        }
      }
    }
  },
  "Install now opens the DMG and quits ClashX Meta. Drag the app into Applications to finish replacing it. The installer is saved at:": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Install now opens the DMG and quits ClashX Meta. Drag the app into Applications to finish replacing it. The installer is saved at:"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "立即安装将打开 DMG 并退出 ClashX Meta。请将应用拖入“应用程序”完成替换。安装包已保存至："
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "立即安裝將開啟 DMG 並結束 ClashX Meta。請將應用程式拖入「應用程式」完成替換。安裝包已儲存至："
        }
      }
    }
  },
  "Installer download complete": {
    "extractionState": "manual",
