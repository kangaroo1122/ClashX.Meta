    "Download the ZIP, quit ClashX Meta, then unzip and replace the app. Updates are not installed automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载 ZIP 后，请先退出 ClashX Meta，再解压并替换应用。更新不会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載 ZIP 後，請先結束 ClashX Meta，再解壓縮並替換應用程式。更新不會自動安裝。"
          }
        }
      }
    },
    "The release has no matching download yet. Open the release page to check its downloads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该版本暂未提供匹配的下载文件，请前往发布页面查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
