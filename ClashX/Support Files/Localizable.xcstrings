{
  "sourceLanguage": "en",
  "strings": {
  "The core did not apply the TUN IPv6 setting.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "The core did not apply the TUN IPv6 setting."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "内核未应用 TUN IPv6 设置。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "核心未套用 TUN IPv6 設定。"
        }
      }
    }
  },
  "Off by default: TUN captures IPv4 only. Enabling also requires global IPv6 support.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Off by default: TUN captures IPv4 only. Enabling also requires global IPv6 support."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "默认关闭，仅接管 IPv4。开启还需要全局 IPv6 支持。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "預設關閉，僅接管 IPv4。開啟還需要全域 IPv6 支援。"
        }
      }
    }
  },
  "TUN IPv6": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "TUN IPv6"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "TUN IPv6"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "TUN IPv6"
        }
      }
    }
  },
  "Used only when the configuration has no DNS section. Separate from TUN DNS. Saved changes apply the next time a local configuration is loaded.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Used only when the configuration has no DNS section. Separate from TUN DNS. Saved changes apply the next time a local configuration is loaded."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "仅当配置没有 DNS 设置时使用，与 TUN DNS 独立。保存后，下次加载本地配置时生效。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "僅當設定沒有 DNS 設定時使用，與 TUN DNS 獨立。儲存後，下次載入本機設定時生效。"
        }
      }
    }
  },
  "Enter at least one valid HTTPS DNS address.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Enter at least one valid HTTPS DNS address."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "请至少填写一个有效的 HTTPS DNS 地址。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "請至少填寫一個有效的 HTTPS DNS 位址。"
        }
      }
    }
  },
  "Restore default DNS": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Restore default DNS"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "恢复默认"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "恢復預設"
        }
      }
    }
  },
  "Save fallback DNS": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Save fallback DNS"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "保存"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "儲存"
        }
      }
    }
  },
  "DNS over HTTPS addresses, one per line.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "DNS over HTTPS addresses, one per line."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "DNS over HTTPS 地址，每行一个。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "DNS over HTTPS 位址，每行一個。"
        }
      }
    }
  },
  "Fallback DNS": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Fallback DNS"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "备用 DNS"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "備用 DNS"
        }
      }
    }
  },
  "Download the installer with progress in the app. When it finishes, choose whether to open the DMG and quit ClashX Meta to install it.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Download the installer with progress in the app. When it finishes, choose whether to open the DMG and quit ClashX Meta to install it."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "在应用内下载安装包并查看进度。完成后可选择是否打开 DMG 并退出 ClashX Meta 进行安装。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "在應用程式內下載安裝包並查看進度。完成後可選擇是否開啟 DMG 並結束 ClashX Meta 進行安裝。"
        }
      }
    }
  },
  "Unable to open installer": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Unable to open installer"
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法打开安装包"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "無法開啟安裝包"
        }
      }
    }
  },
  "Show in Finder": {
    "extractionState": "manual",
