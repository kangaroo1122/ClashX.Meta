  "strings": {
  "Unable to prepare the previous configuration for rollback.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Unable to prepare the previous configuration for rollback."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "无法准备用于回退的上次生效配置。"
        }
      }
    }
  },
  "No previously applied configuration is available for rollback. Reload a working subscription.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "No previously applied configuration is available for rollback. Reload a working subscription."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "没有可用于回退的已生效配置，请重新加载可用的订阅。"
        }
      }
    }
  },
  "A group references a missing proxy or group. Update its members after renaming or deleting an entry.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A group references a missing proxy or group. Update its members after renaming or deleting an entry."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "代理组引用了不存在的代理或组，重命名或删除后请更新成员。"
        }
      }
    }
  },
  "A proxy or group uses a reserved name.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A proxy or group uses a reserved name."
