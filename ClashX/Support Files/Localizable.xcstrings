  "Too many core logs. Reception will resume automatically after 60 seconds.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Too many core logs. Reception will resume automatically after 60 seconds."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "内核日志过于频繁，60 秒后自动恢复接收。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "核心日誌過於頻繁，60 秒後自動恢復接收。"
        }
      }
    }
  },
