  "A personal node dialer reference is ambiguous. Use a unique node name.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A personal node dialer reference is ambiguous. Use a unique node name."
