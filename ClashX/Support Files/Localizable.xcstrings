    "Download and open the DMG, quit ClashX Meta, then drag the app into Applications to replace it. Updates are not installed automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载并打开 DMG，先退出 ClashX Meta，再将应用拖入 Applications 并确认替换。更新不会自动安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載並開啟 DMG，先結束 ClashX Meta，再將應用程式拖入 Applications 並確認替換。更新不會自動安裝。"
          }
        }
      }
    },
    "Checking for updates…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查更新…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查更新…"
          }
        }
      }
    },
    "Update check failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新失败"
