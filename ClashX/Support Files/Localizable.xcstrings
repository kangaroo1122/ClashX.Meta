    },
    "No public stable release was found in the update repository. Branch build artifacts are not releases.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新仓库中未找到公开的正式版本。分支构建产物不属于 Release。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新儲存庫中找不到公開的正式版本。分支建置產物不屬於 Release。"
          }
        }
      }
    },
    "GitHub refused the request or its rate limit was reached. Please try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 拒绝了请求或已达到请求频率限制，请稍后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 拒絕了請求或已達到請求頻率限制，請稍後重試。"
          }
        }
      }
    },
    "Unable to compare release versions. Use numeric version tags such as v1.2.3 or v1.2.3-1.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法比较版本号。请使用 v1.2.3 或 v1.2.3-1 这样的数字版本标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法比較版本號。請使用 v1.2.3 或 v1.2.3-1 這樣的數字版本標籤。"
          }
        }
      }
    },
    "No newer release": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
