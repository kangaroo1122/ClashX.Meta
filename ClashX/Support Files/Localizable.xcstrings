  "This personal node is still referenced. Update or remove its dialer-proxy references before deleting it.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "This personal node is still referenced. Update or remove its dialer-proxy references before deleting it."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "此自有节点仍被引用，请先修改或移除指向它的 dialer-proxy，再删除。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "此自有節點仍被引用，請先修改或移除指向它的 dialer-proxy，再刪除。"
        }
      }
    }
  },
  "A deleted personal node is still referenced. Update or remove its dialer-proxy references before saving.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "A deleted personal node is still referenced. Update or remove its dialer-proxy references before saving."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "已删除的自有节点仍被引用，请先修改或移除指向它的 dialer-proxy，再保存。"
        }
      },
      "zh-Hant": {
        "stringUnit": {
          "state": "translated",
          "value": "已刪除的自有節點仍被引用，請先修改或移除指向它的 dialer-proxy，再儲存。"
        }
      }
    }
  },
