  },
  "Fallback tries members from top to bottom. Groups may contain other custom groups; circular references are rejected.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Fallback tries members from top to bottom. Groups may contain other custom groups; circular references are rejected."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "自动回退按顺序选择可用成员。允许引用其他自定义代理组，不允许循环引用。"
        }
      }
    }
  },
