  "Applied to every local subscription. Custom rules run first; unmatched traffic follows the subscription. Use Rule mode for routing.": {
    "extractionState": "manual",
    "localizations": {
      "en": {
        "stringUnit": {
          "state": "translated",
          "value": "Applied to every local subscription. Custom rules run first; unmatched traffic follows the subscription. Use Rule mode for routing."
        }
      },
      "zh-Hans": {
        "stringUnit": {
          "state": "translated",
          "value": "自动应用于所有本地订阅。优先匹配自定义规则，未命中的流量继续按订阅处理；分流需使用规则模式。"
        }
      }
    }
  },
